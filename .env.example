# Copia este archivo como .env y rellénalo. El .env nunca va a git.

# Clave para firmar la cookie de sesión. Genera una con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si falta, en desarrollo se genera una aleatoria (las sesiones se pierden al reiniciar).
SECRET_KEY=

# Base de datos SQLite (dentro de data/, que está fuera de git)
CRM_DB_PATH=data/crm.db

# Dirección y puerto de la web (127.0.0.1 = solo accesible desde este PC)
CRM_HOST=127.0.0.1
CRM_PORT=8000

# Ruta de la bóveda de Obsidian, solo para `crm exportar-obsidian`
# (en el PC de Raúl: C:/Users/Raul/CONSULTORIA)
CRM_VAULT_PATH=
